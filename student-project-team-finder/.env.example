# Copy to .env and export these values before starting the API.
# For Render, replace localhost with your MySQL provider's public hostname.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=student_team_finder
DB_USERNAME=teamfinder_app
DB_PASSWORD=change_me
JWT_SECRET=replace-with-a-base64-or-long-random-development-secret-at-least-32-characters
JWT_EXPIRATION_MINUTES=480
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://teamfinder-five.vercel.app
